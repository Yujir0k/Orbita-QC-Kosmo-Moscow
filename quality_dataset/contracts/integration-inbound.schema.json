{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cosmo-quality/integration-inbound/1.0",
  "title": "Synthetic ERP work-order delivery v1.0",
  "type": "object",
  "required": ["delivery_id", "deliver_at", "message"],
  "additionalProperties": false,
  "properties": {
    "delivery_id": {"type": "string"},
    "deliver_at": {"type": "string", "format": "date-time"},
    "message": {
      "type": "object",
      "required": ["message_id", "message_type", "schema_version", "source_system", "sent_at", "payload"],
      "additionalProperties": false,
      "properties": {
        "message_id": {"type": "string"},
        "message_type": {"const": "work_order"},
        "schema_version": {"const": "1.0"},
        "source_system": {"const": "ERP-EMU"},
        "sent_at": {"type": "string", "format": "date-time"},
        "payload": {
          "type": "object",
          "required": ["work_order_id", "item_type_id", "assembly_revision", "item_ids", "quantity"],
          "additionalProperties": false,
          "properties": {
            "work_order_id": {"type": "string"},
            "item_type_id": {"type": "string"},
            "assembly_revision": {"type": "string"},
            "item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "quantity": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
